# PyroNexa 26 - Environment Configuration
# Copy this file to .env and insert your NASA FIRMS MAP Key

# NASA FIRMS API Map Key
# Obtain a free key from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# If left empty, PyroNexa automatically operates in scientific simulation / sample mode
FIRMS_MAP_KEY=

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=pyronexa-2026-space-apps-secret-dev-key

# Server settings
PORT=5000
HOST=127.0.0.1

# Cache expiration in seconds (default: 3600 = 1 hour)
FIRMS_CACHE_TTL=3600

# Default region preset (e.g. north_america, amazon, mediterranean, australia)
DEFAULT_REGION=north_america
